---
import Layout from "../layouts/Layout.astro";
import ParticlePortrait from "../components/ParticlePortrait.jsx";
---

<Layout>
    <main class="grid grid-cols-1 md:grid-cols-11 flex-1 min-h-0 px-8 py-6">
        <section class="hidden md:flex md:col-span-1 items-center justify-start">
            <span class="vertical-text">SOFTWARE ENGINEER</span>
        </section>

        <section class="col-span-1 md:col-span-9 flex flex-col justify-center">
            <ParticlePortrait
                client:only="react"
                imageSrc="/images/particle-index-reference.jpg"
                className="w-full h-full"
            />
        </section>

        <section class="col-span-1 flex md:flex justify-end items-center mt-2 md:mt-0">
            <span class="vertical-text resume-text cursor-pointer">DOWNLOAD RESUME</span>
        </section>
    </main>

    <style>
        h2 {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.05em;
        }

        .vertical-text {
            writing-mode: vertical-rl;
            text-orientation: upright;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .resume-text {
            position: relative;
            width: fit-content;
        }

        .resume-text::after {
            content: "";
            position: absolute;
            top: 0;
            right: -4px;

            width: 2px;
            height: 100%;

            background-color: #ffff;

            transform: scaleY(0);
            transform-origin: bottom;
            transition: transform 0.3s ease;
        }

        .resume-text:hover::after {
            transform: scaleY(1);
        }
    </style>
</Layout>
