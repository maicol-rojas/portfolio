---
import Layout from "../layouts/Layout.astro";
import ParticlePortrait from "../components/ParticlePortrait.jsx";
---

<Layout>
    <main class="grid grid-cols-1 md:grid-cols-[auto_1fr_auto] flex-1 min-h-0 px-8 py-6">
        <section class="hidden md:flex items-center justify-start">
            <span class="vertical-text">SOFTWARE ENGINEER</span>
        </section>

        <section class="flex flex-row min-w-0">
            <div class="brutalist-text-col">
                <div class="brutalist-text">
                    <span class="brutalist-text--lg">CREATIVE</span>
                    <span class="brutalist-text--outline">FULLSTACK</span>
                    <span class="brutalist-text--lg">DEVELOPER</span>
                </div>
            </div>

            <div class="portrait-col">
                <ParticlePortrait
                    client:only="react"
                    imageSrc="/images/particle-index-reference.jpg"
                    className="w-full h-full"
                />
            </div>
        </section>

        <section class="flex items-center justify-end mt-2 md:mt-0">
            <span class="vertical-text resume-text cursor-pointer">DOWNLOAD RESUME</span>
        </section>
    </main>

    <style>
        h2 {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.05em;
        }

        .vertical-text {
            writing-mode: vertical-rl;
            text-orientation: upright;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .resume-text {
            position: relative;
            width: fit-content;
        }

        .resume-text::after {
            content: "";
            position: absolute;
            top: 0;
            right: -4px;

            width: 2px;
            height: 100%;

            background-color: var(--theme-fg);

            transform: scaleY(0);
            transform-origin: bottom;
            transition: transform 0.3s ease;
        }

        .resume-text:hover::after {
            transform: scaleY(1);
        }

        .brutalist-text-col {
            display: flex;
            flex-shrink: 0;
            align-items: flex-start;
            justify-content: flex-start;
        }

        .brutalist-text {
            display: flex;
            flex-direction: column;
            align-items: start;
            justify-content: start;
            margin-left: 6rem;
        }

        .brutalist-text span {
            font-family: var(--font-satoshi);
            font-weight: 900;
            font-size: clamp(40px, 7vw, 96px);
            line-height: 0.9;
            letter-spacing: -0.03em;
            text-transform: uppercase;
            text-align: left;
        }

        .brutalist-text span.brutalist-text--lg {
            font-size: clamp(50px, 8.5vw, 124px);
        }

        .brutalist-text span.brutalist-text--outline {
            color: transparent;
            -webkit-text-stroke: 1.5px var(--theme-fg);
        }

        .portrait-col {
            flex: 1;
            min-width: 0;
            margin-left: -3rem;
        }
    </style>
</Layout>
