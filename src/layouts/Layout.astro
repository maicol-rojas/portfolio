---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Loader from "../components/Loader.astro";
import ClickSound from "../components/ClickSound.astro";

const {
	navVariant = "default",
	hideFooter = false,
	showThemeToggle = true,
	initialBg,
	initialFg,
} = Astro.props;

const themeOverride =
	initialBg && initialFg
		? `--theme-bg: ${initialBg}; --theme-fg: ${initialFg};`
		: undefined;
---

<!doctype html>
<html lang="en" style={themeOverride}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&display=swap"
			rel="stylesheet"
		/>
		<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet" />

		<meta name="generator" content={Astro.generator} />
		<title>maicol rojas - portfolio</title>
	</head>

	<body class="px-2 h-dvh flex flex-col overflow-hidden">
		<ClickSound />
		<Loader />
		<Navbar variant={navVariant} showThemeToggle={showThemeToggle} />
		<slot />
		{!hideFooter && <Footer />}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
