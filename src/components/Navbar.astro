---
const today = new Date()
    .toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
    })
    .replace(/\//g, ".");
---

<header class="flex flex-row items-center justify-between py-6 px-4">
    <a href="#hero" class="brand-text" data-text="MAICOL ROJAS">
        <span>MAICOL ROJAS</span>
    </a>

    <span class="date-text">{today}</span>

    <a href="#about" class="items-text" data-text="ABOUT">
        <span>ABOUT</span>
    </a>
</header>

<style>
    .brand-text,
    .items-text {
        position: relative;
        display: inline-block;
        overflow: hidden;
        height: 18px;

        font-family: "Inconsolata", monospace;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        line-height: 18px;

        cursor: pointer;
        color: inherit;
        text-decoration: none;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
    }

    .date-text {
        font-family: "Inconsolata", monospace;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        line-height: 18px;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
        animation-delay: 0.1s;
    }

    @keyframes drop-in {
        from {
            opacity: 0;
            transform: translateY(-24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .brand-text span,
    .items-text span {
        display: inline-block;
        transition: transform 0.35s ease;
    }

    .brand-text::after,
    .items-text::after {
        content: attr(data-text);
        position: absolute;
        left: 0;
        top: 100%;
        width: 100%;
        transition: transform 0.35s ease;
    }

    .brand-text:hover span,
    .brand-text:hover::after,
    .items-text:hover span,
    .items-text:hover::after {
        transform: translateY(-100%);
    }

    .items-text.selected {
        color: #f7e49b;
    }
</style>
