---
const navItems = [
    { label: "HOME", href: "#hero" },
    { label: "ABOUT", href: "#about" },
    { label: "PROJECTS", href: "#projects" },
    { label: "SNAPSHOT", href: "#snapshot " },
    { label: "CONTACT", href: "#contact" },
];
---

<header class="flex flex-row items-center justify-end py-6">
    <nav class="w-full md:w-auto md:ml-40">
        <ul class="grid grid-cols-3 gap-x-6 gap-y-5 md:flex md:flex-row md:gap-14">
            {
                navItems.map((item, index) => (
                    <li class="nav-item" style={`animation-delay: ${index * 0.1}s`}>
                        <a href={item.href} class="items-text" data-text={item.label}>
                            <span>{item.label}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<style>
    .nav-item {
        opacity: 0;
        animation: drop-in 0.6s ease forwards;
    }

    @keyframes drop-in {
        from {
            opacity: 0;
            transform: translateY(-24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .items-text {
        position: relative;
        display: inline-block;
        overflow: hidden;
        height: 18px;

        font-family: "Inconsolata", monospace;
        font-size: 1.125rem;
        font-weight: 800;
        letter-spacing: 2px;
        line-height: 18px;

        cursor: pointer;
        color: inherit;
        text-decoration: none;
    }

    .items-text span {
        display: inline-block;
        transition: transform 0.35s ease;
    }

    .items-text::after {
        content: attr(data-text);
        position: absolute;
        left: 0;
        top: 100%;
        width: 100%;
        transition: transform 0.35s ease;
    }

    .items-text:hover span,
    .items-text:hover::after {
        transform: translateY(-100%);
    }

    .items-text.selected {
        color: #f7e49b;
    }
</style>
