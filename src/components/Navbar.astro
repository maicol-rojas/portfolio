---
const { variant = "default" } = Astro.props;

const today = new Date()
    .toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
    })
    .replace(/\//g, ".");

const navItems = [
    { label: "HOME", href: "/" },
    { label: "ABOUT", href: "/about" },
    { label: "PROJECT", href: "/#projects" },
    { label: "CONTACT", href: "/#contact" },
];
---

<header class="flex flex-row items-center justify-between py-6 px-4">
    <a
        href={variant === "nav" ? "/" : "#hero"}
        class="brand-text"
        data-text="MAICOL ROJAS"
    >
        <span>MAICOL ROJAS</span>
    </a>

    {
        variant === "default" && (
            <>
                <span class="date-text">{today}</span>

                <a href="/about" class="items-text" data-text="ABOUT">
                    <span>ABOUT</span>
                </a>
            </>
        )
    }

    {
        variant === "nav" && (
            <nav class="nav-items">
                {navItems.map((item) => (
                    <a href={item.href} class="items-text" data-text={item.label}>
                        <span>{item.label}</span>
                    </a>
                ))}
            </nav>
        )
    }

    <button
        id="theme-toggle"
        type="button"
        class="theme-toggle"
        aria-label="Cambiar combinación de color"
        title="Cambiar color"
    >
        ◐
    </button>
</header>

<script>
    const themes = [
        { bg: "#323B3F", fg: "#ffffff" },
        { bg: "#f3e8bc", fg: "#035352" },
        { bg: "#ffecae", fg: "#f17141" },
        { bg: "#ee6c4d", fg: "#20201f" },
        { bg: "#f3eee5", fg: "#0b0b0b" },
        { bg: "#ff6044", fg: "#121313" },
    ];

    let index = 0;

    const button = document.getElementById("theme-toggle");
    button?.addEventListener("click", () => {
        index = (index + 1) % themes.length;
        const { bg, fg } = themes[index];
        document.body.style.backgroundColor = bg;
        document.body.style.color = fg;
    });
</script>

<style>
    .brand-text,
    .items-text {
        position: relative;
        display: inline-block;
        overflow: hidden;
        height: 18px;

        font-family: "Inconsolata", monospace;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        line-height: 18px;

        cursor: pointer;
        color: inherit;
        text-decoration: none;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
    }

    .date-text {
        font-family: "Inconsolata", monospace;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        line-height: 18px;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
        animation-delay: 0.1s;
    }

    @keyframes drop-in {
        from {
            opacity: 0;
            transform: translateY(-24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .brand-text span,
    .items-text span {
        display: inline-block;
        transition: transform 0.35s ease;
    }

    .brand-text::after,
    .items-text::after {
        content: attr(data-text);
        position: absolute;
        left: 0;
        top: 100%;
        width: 100%;
        transition: transform 0.35s ease;
    }

    .brand-text:hover span,
    .brand-text:hover::after,
    .items-text:hover span,
    .items-text:hover::after {
        transform: translateY(-100%);
    }

    .items-text.selected {
        color: #f7e49b;
    }

    .nav-items {
        display: flex;
        align-items: center;
        gap: 32px;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
        animation-delay: 0.1s;
    }

    .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;

        font-size: 16px;
        line-height: 1;

        color: inherit;
        background: transparent;
        border: 1px solid currentColor;
        border-radius: 999px;
        cursor: pointer;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
        animation-delay: 0.2s;

        transition: transform 0.35s ease;
    }

    .theme-toggle:hover {
        transform: rotate(180deg);
    }
</style>
