---
const { variant = "default" } = Astro.props;

const now = new Date();
const today = now
    .toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
    })
    .replace(/\//g, ".");
const currentTime = now.toLocaleTimeString("en-GB", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
});

const navItems = [
    { label: "HOME", href: "/" },
    { label: "ABOUT", href: "/about" },
    { label: "PROJECT", href: "/#projects" },
    { label: "CONTACT", href: "/#contact" },
];
---

<header class="flex flex-row items-center justify-between py-6 px-4">
    <a
        href={variant === "nav" ? "/" : "#hero"}
        class="brand-text"
        data-text="MAICOL ROJAS"
    >
        <span>MAICOL ROJAS</span>
    </a>

    {
        variant === "default" && (
            <>
                <span class="date-text" id="date-time-text" data-date={today}>
                    {today} - {currentTime}
                </span>

                <a href="/about" class="items-text" data-text="ABOUT">
                    <span>ABOUT</span>
                </a>
            </>
        )
    }

    {
        variant === "nav" && (
            <nav class="nav-items">
                {navItems.map((item) => (
                    <a href={item.href} class="items-text" data-text={item.label}>
                        <span>{item.label}</span>
                    </a>
                ))}
            </nav>
        )
    }
</header>

<script>
    function updateDateTime() {
        const el = document.getElementById("date-time-text");
        if (!el) return;

        const now = new Date();
        const date = now
            .toLocaleDateString("en-GB", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
            })
            .replace(/\//g, ".");
        const time = now.toLocaleTimeString("en-GB", {
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
        });
        el.textContent = `${date} - ${time}`;
    }

    if (document.getElementById("date-time-text")) {
        // se alinea al cambio de minuto exacto y luego se repite cada 60s
        const msToNextMinute = 60000 - (Date.now() % 60000);
        window.setTimeout(() => {
            updateDateTime();
            window.setInterval(updateDateTime, 60000);
        }, msToNextMinute);
    }
</script>

<style>
    .brand-text,
    .items-text {
        position: relative;
        display: inline-block;
        overflow: hidden;
        height: 18px;

        font-family: "Inconsolata", monospace;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        line-height: 18px;

        cursor: pointer;
        color: inherit;
        text-decoration: none;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
    }

    .date-text {
        font-family: "Inconsolata", monospace;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        line-height: 18px;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
        animation-delay: 0.1s;
    }

    @keyframes drop-in {
        from {
            opacity: 0;
            transform: translateY(-24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .brand-text span,
    .items-text span {
        display: inline-block;
        transition: transform 0.35s ease;
    }

    .brand-text::after,
    .items-text::after {
        content: attr(data-text);
        position: absolute;
        left: 0;
        top: 100%;
        width: 100%;
        transition: transform 0.35s ease;
    }

    .brand-text:hover span,
    .brand-text:hover::after,
    .items-text:hover span,
    .items-text:hover::after {
        transform: translateY(-100%);
    }

    .items-text.selected {
        color: #f7e49b;
    }

    .nav-items {
        display: flex;
        align-items: center;
        gap: 32px;

        opacity: 0;
        animation: drop-in 0.6s ease forwards;
        animation-delay: 0.1s;
    }
</style>
